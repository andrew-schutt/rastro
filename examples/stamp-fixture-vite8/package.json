{
  "name": "stamp-fixture-vite8",
  "version": "0.0.0",
  "private": true,
  "description": "examples/stamp-fixture's app, built with Vite 8 and plugin-react v6 through @rolldown/plugin-babel, and audited with the same suite.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --mode misordered",
