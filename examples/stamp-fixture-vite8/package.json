    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-rastro": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
