{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `core` is framework-agnostic: no React, no Node APIs. DOM is types-only —
    // `Element` is needed for the FingerprintStrategy seam, nothing is called at runtime.
    "lib": ["ES2022", "DOM"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
