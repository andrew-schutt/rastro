{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser SDK: DOM types, React JSX. No Node APIs.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
