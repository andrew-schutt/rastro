{
  "name": "rastro-react",
  "version": "0.0.1",
  "description": "rastro-react \u2014 the SDK: one provider, auto-capture, OTLP out.",
  "license": "MIT",
  "author": "Andrew Schutt <me@andrew-schutt.com>",
  "homepage": "https://github.com/andrew-schutt/rastro/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-schutt/rastro.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/andrew-schutt/rastro/issues",
  "keywords": [
    "react",
    "opentelemetry",
    "otel",
    "otlp",
    "ux",
    "telemetry",
    "analytics",
    "autocapture",
    "product-analytics",
    "user-flows"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "rastro-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
