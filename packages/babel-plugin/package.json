{
  "name": "babel-plugin-rastro",
  "version": "0.0.1",
  "description": "Build-time component annotation for Rastro: stable element identity that survives minification.",
  "license": "MIT",
  "author": "Andrew Schutt <me@andrew-schutt.com>",
  "homepage": "https://github.com/andrew-schutt/rastro/tree/main/packages/babel-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-schutt/rastro.git",
    "directory": "packages/babel-plugin"
  },
  "bugs": "https://github.com/andrew-schutt/rastro/issues",
  "keywords": [
    "babel-plugin",
    "rastro",
    "react",
    "telemetry",
