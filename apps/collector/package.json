{
  "name": "collector",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify: OTLP ingest + graph/session API. The only backend process.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
